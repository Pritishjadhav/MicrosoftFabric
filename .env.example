# ============================================================
# Microsoft Entra ID (Azure Active Directory) Configuration
# ============================================================

# Azure Tenant ID (Directory ID) from the Azure Portal
AZURE_TENANT_ID=your-azure-tenant-id

# Application (Client) ID from your App Registration
AZURE_CLIENT_ID=your-azure-client-id

# Client Secret Value from your App Registration's "Certificates & secrets"
AZURE_CLIENT_SECRET=your-azure-client-secret

# ============================================================
# NextAuth.js Configuration
# ============================================================

# A random string used to hash tokens, sign/encrypt cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

# The canonical URL of your application
# For development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Microsoft Fabric Configuration
# ============================================================

# Fabric Workspace ID (GUID) from the Fabric Portal URL
# Example: https://app.fabric.microsoft.com/groups/{WORKSPACE_ID}
FABRIC_WORKSPACE_ID=your-fabric-workspace-id

# Fabric Lakehouse ID (GUID) from the Fabric Portal
FABRIC_LAKEHOUSE_ID=your-fabric-lakehouse-id

# Fabric Lakehouse SQL Connection String for metadata operations
# Found in Lakehouse Settings > SQL Analytics Endpoint
# Format: your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=your-workspace.datawarehouse.fabric.microsoft.com

# Fabric Lakehouse Database Name (usually the Lakehouse name)
FABRIC_DATABASE_NAME=your-lakehouse-name

# ============================================================
# Upload Configuration
# ============================================================

# Maximum file size in megabytes (default: 100 MB)
MAX_FILE_SIZE_MB=100

# Comma-separated list of allowed MIME types
# Leave empty to allow all types, or restrict as needed
ALLOWED_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/json,text/plain,image/jpeg,image/png,image/gif,application/zip,application/x-zip-compressed

# ============================================================
# Application Configuration
# ============================================================

# Node environment: development | production | test
NODE_ENV=development
